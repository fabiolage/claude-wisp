<Window x:Class="Wisp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wisp"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#F2F5FF" />
        <SolidColorBrush x:Key="InkSoft" Color="#B3C3CFE6" />
        <SolidColorBrush x:Key="InkFaint" Color="#80C3CFE6" />
        <DropShadowEffect x:Key="Glow" Color="#DDE6FF" BlurRadius="10" ShadowDepth="0" Opacity="0.45" />
    </Window.Resources>

    <Border x:Name="Card" Margin="14" CornerRadius="16" Padding="16,11,16,13" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#33161A24" Offset="0" />
                <GradientStop Color="#4D0C0F17" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#40FFFFFF" Offset="0" />
                <GradientStop Color="#10FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity="0.22" />
        </Border.Effect>

        <StackPanel Width="196">
            <!-- Header -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Pulse" Width="5" Height="5" Fill="{StaticResource Ink}" Margin="0,1,7,0" Opacity="0.7" />
                    <TextBlock Text="C L A U D E" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" />
                </StackPanel>
                <TextBlock x:Name="LabelText" Text="session" HorizontalAlignment="Right" FontSize="10"
                           Foreground="{StaticResource InkFaint}" VerticalAlignment="Center" />
            </Grid>

            <!-- Big number + reset countdown -->
            <Grid Margin="0,3,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Effect="{StaticResource Glow}">
                    <TextBlock x:Name="PercentText" Text="··" FontSize="34" FontWeight="Light"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock x:Name="PercentSign" Text="%" FontSize="15" FontWeight="Light" Margin="2,0,0,7"
                               VerticalAlignment="Bottom" Foreground="{StaticResource InkSoft}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,7">
                    <TextBlock x:Name="ResetCaption" Text="resets in" FontSize="9.5" HorizontalAlignment="Right"
                               Foreground="{StaticResource InkFaint}" />
                    <TextBlock x:Name="ResetText" Text="—" FontSize="13" HorizontalAlignment="Right"
                               Foreground="{StaticResource InkSoft}" />
                </StackPanel>
            </Grid>

            <!-- Session bar -->
            <Grid x:Name="SessionTrack" Height="3" Margin="0,2,0,0">
                <Border CornerRadius="1.5" Background="#24FFFFFF" />
                <Border x:Name="SessionBar" CornerRadius="1.5" HorizontalAlignment="Left" Width="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#99FFFFFF" Offset="0" />
                            <GradientStop x:Name="SessionAccent" Color="#CFE0FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect x:Name="SessionGlow" Color="#CFE0FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                    </Border.Effect>
                </Border>
            </Grid>

            <!-- Weekly row -->
            <Grid x:Name="WeekRow" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="week" FontSize="10" Foreground="{StaticResource InkFaint}" VerticalAlignment="Center" />
                <Grid x:Name="WeekTrack" Grid.Column="1" Height="2" Margin="8,1,8,0" VerticalAlignment="Center">
                    <Border CornerRadius="1" Background="#1AFFFFFF" />
                    <Border x:Name="WeekBar" CornerRadius="1" HorizontalAlignment="Left" Width="0" Background="#8CDDE6FF" />
                </Grid>
                <TextBlock x:Name="WeekText" Grid.Column="2" Text="—" FontSize="10" MinWidth="26" TextAlignment="Right"
                           Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
            </Grid>

            <!-- Status line, only shown when something is wrong -->
            <TextBlock x:Name="StatusText" Visibility="Collapsed" Margin="0,7,0,0" FontSize="10" TextTrimming="CharacterEllipsis"
                       Foreground="#E6F2B8A8" />
        </StackPanel>
    </Border>
</Window>
