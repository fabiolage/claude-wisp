<Window x:Class="Wisp.SessionKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wisp · claude.ai session key"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#15171F"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="#E8ECF5">
    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="Connect to claude.ai" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#A9B2C6" FontSize="12.5" LineHeight="18">
            Only needed if you don't use Claude Code on this PC. In your browser, open claude.ai, press F12,
            go to Application → Cookies → https://claude.ai and copy the value of
            <Run FontWeight="SemiBold" Foreground="#E8ECF5">sessionKey</Run>. It is stored encrypted for your Windows user only.
        </TextBlock>
        <PasswordBox x:Name="KeyBox" Margin="0,14,0,0" Padding="8,6" Background="#0E1016" Foreground="#E8ECF5"
                     BorderBrush="#33FFFFFF" CaretBrush="#E8ECF5" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Clear" Width="76" Margin="0,0,8,0" Click="Clear_Click" />
            <Button Content="Cancel" Width="76" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Width="76" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
